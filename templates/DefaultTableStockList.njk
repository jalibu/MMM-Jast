{% macro render() %}
<table class="{{ config.tableClass }}">
  {% for stock in stocks %}
  {% set view = utils.getStockView(stock, config) %}
  {% set color = "green" if view.change.trend == "high" else ("red" if view.change.trend == "low" else "") %}
  <tr>
    <td class="bright"><span>{{ view.name }}</span></td>
    <td>
      <span>{{ view.value }}</span>
    </td>
    <td>
      <span>
        <span>
          <span style="{% if color %} color:{{ color }}{% endif %}">{{ view.change.sign }}{{ view.change.percent }}</span>
        </span>
      </span>
    </td>
  </tr>
  {% endfor %}
</table>
{% endmacro %}
