{% macro render() %}
<table class="{{ config.tableClass }}">
  {% for stock in tableStocks %}
  {% set view = utils.getStockView(stock, config) %}
  <tr>
    <td class="bright"><span>{{ view.name }}</span></td>
    <td>
      <span>{{ view.value }}</span>
    </td>
    <td>
      <span>
        <span>
          <span class="jast-default-table-change {{ view.change.trend }}">{{ view.change.sign }}{{ view.change.percent }}</span>
        </span>
      </span>
    </td>
  </tr>
  {% endfor %}
</table>
{% endmacro %}
