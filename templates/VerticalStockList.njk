{% import "templates/StockList.njk" as stockList with context %}
{% import "templates/VerticalScrollStyle.njk" as vss with context %}
{% macro render() %}
  {% if config.displayMode == "vertical" %}
    {{ vss.render(config) }}
    {% set animationStyle = ' style="animation-duration: ' + utils.getTickerItemCount(stocks, config) * config.fadeSpeedInSeconds + 's"' %}
  {% else %}
    {% set animationStyle = '' %}
  {% endif %}
    <ul {{ animationStyle | safe }}>
      {{ stockList.render() }}
      {% if config.displayMode == "vertical" %}
        {{ stockList.render() }}
      {% endif %}
    </ul>
{% endmacro %}
