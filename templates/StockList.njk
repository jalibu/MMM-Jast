{% macro render() %}
  {% for stock in stocks %}
    {% set view = utils.getStockView(stock, config) %}
    {% if view.visible %}
      <li class="jast-stock">
        <span class="jast-stock-name">{{ view.name }}:</span>
        <span class="jast-values-wrapper {{ view.change.trend }}">
          <span class="jast-change-wrapper">{{ view.value }}</span>
          {% if view.change.trend and (config.showChangeValue or config.showChangePercent) %}
            <span class="jast-change">
              ({% if config.showChangeValue %}<span class="jast-change-value">{{ view.change.sign }}{{ view.change.value }}</span>{% endif %}
              {% if config.showChangePercent %}<span class="jast-change-value">{{ view.change.sign }}{{ view.change.percent }}</span>{% endif %})
            </span>
          {% endif %}
        </span>

        <span class="jast-performance {{ view.performance.trend }}">
          {% if view.performance.trend and (config.showStockPerformanceValue or config.showStockPerformancePercent) %}
            <span class="jast-change">
              (
                {% if config.showStockPerformanceValue %}<span class="jast-change-value">{{ view.performance.sign }}{{ view.performance.value }}</span>{% endif %}
                {% if config.showStockPerformanceValueSum %}<span class="jast-change-value">{{ view.performance.sign }}{{ view.performanceSum }}</span>{% endif %}
                {% if config.showStockPerformancePercent %}<span class="jast-change-value">{{ view.performance.sign }}{{ view.performance.percent }}</span>{% endif %}
              )
            </span>
          {% endif %}
        </span>
      </li>
    {% endif %}
  {% endfor %}
  {% if config.showPortfolioValue or config.showPortfolioGrowth or config.showPortfolioGrowthPercent %}
    <li class="jast-stock portfolio">{{ "portfolio" | translate | safe }}
      {% for entry in utils.getPortfolio(stocks, config) %}
        {% set view = utils.getPortfolioView(entry, config) %}
        {% set extraCurrency = " jast-multi-currency" if loop.index != 1 else "" %}
        <span class="jast-portfolio {{ view.change.trend }}{{ extraCurrency }}">
          {% if config.showPortfolioValue %} {{ view.value }} {% endif %}
          {% if view.change.trend and (config.showPortfolioGrowth or config.showPortfolioGrowthPercent) %}
            {% if config.showPortfolioValue %}<span class="jast-change">({% endif %}
            {% if config.showPortfolioGrowth %}<span class="jast-change-value">{{ view.change.sign }}{{ view.change.value }}</span>{% endif %}
            {% if config.showPortfolioGrowthPercent %}<span class="jast-change-value">{{ view.change.sign }}{{ view.change.percent }}</span>{% endif %}
            {% if config.showPortfolioValue %})</span>{% endif %}
          {% endif %}
        </span>
        <span class="jast-portfolio-performance {{ view.performance.trend }}{{ extraCurrency }}">
          {% if view.change.trend and (config.showPortfolioPerformancePercent or config.showPortfolioPerformanceValue) %}
            (
            {% if config.showPortfolioPerformanceValue %}<span class="jast-change-value">{{ view.performance.sign }}{{ view.performance.value }}</span>{% endif %}
            {% if config.showPortfolioGrowth %}<span class="jast-change-value">{{ view.performance.sign }}{{ view.performance.percent }}</span>{% endif %}
            )
          {% endif %}
        </span>
      {% endfor %}
    </li>
  {% endif %}
  {% if config.showLastUpdate %}
    <li class="jast-stock">{{ "lastUpdate" | translate | safe }} {{ lastUpdate }}</li>
  {% endif %}
{% endmacro %}
