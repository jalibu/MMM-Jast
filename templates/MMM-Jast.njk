{% import "templates/StockList.njk" as stockList with context %}
{% import "templates/TableStockList.njk" as tableStockList with context %}
{% import "templates/DefaultTableStockList.njk" as defaultTableStockList with context %}
{% if stocks.length > 0 %}
  {% if config.displayMode == "default-table" %}
    {{ defaultTableStockList.render() }}
  {% else %}
    <div
      class="normal medium jast-wrapper {{ config.displayMode }}{% if not config.showColors %} monochrome{% endif %}"
      style="max-width: {{ config.maxWidth }}; --jast-ticker-item-count: {{ utils.getTickerItemCount(stocks, config) }}; --jast-ticker-speed: {{ config.fadeSpeedInSeconds }}s;"
    >
      {% if config.displayMode == "horizontal" %}
        {% for tickerNo in [1, 2] %}
          <span class="jast-hticker jast-ticker-no{{ tickerNo }}">
            <ul class="jast-tickerframe">
              {% for i in range(0, config.virtualHorizontalMultiplier) %}
                {{ stockList.render() }}
              {% endfor %}
            </ul>
          </span>
        {% endfor %}
      {% elif config.displayMode == "horizontal-static" %}
        <ul class="jast-static-horizontal-list">
          {{ stockList.render() }}
        </ul>
      {% elif config.displayMode == "table" %}
        {{ tableStockList.render() }}
      {% else %}
        {# vertical repeats the list so the scroll animation loops seamlessly #}
        <ul>
          {{ stockList.render() }}
          {% if config.displayMode == "vertical" %}
            {{ stockList.render() }}
          {% endif %}
        </ul>
      {% endif %}
    </div>
  {% endif %}
{% else %}
  <div class="dimmed light small">
    {{ "LOADING" | translate | safe }}
  </div>
{% endif %}
