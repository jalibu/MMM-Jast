{% macro render() %}
<style>

.jast-wrapper table {
  font-size: 0.7em;
  text-align: right;
}

.jast-wrapper span.badge {
  background: grey;
  color: white;
  padding: 4px 8px;
  text-align: center;
  border-radius: 5px;
}

.jast-wrapper span.badge.high {
  background: green;
}

.jast-wrapper span.badge.high span::before {
  content: '+';
}

.jast-wrapper span.badge.low {
  background: red;
}

.jast-wrapper thead {
  color: #000;
  opacity: 0.5;
  background: #fff;
}

.jast-wrapper tbody tr {
  animation: fadeIn 2s forwards;
}

.jast-wrapper .bold {
font-weight: bold;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
</style>

<table>
  <thead>
    <tr>
      <th></th>
      <th>{{ "stockPrice" | translate | safe }}</th>
      <th>{{ "purchasePrice" | translate | safe }}</th>
      <th>{{ "priceGain" | translate | safe }}</th>
    </tr>
  </thead>
  <tbody>
  {% for stock in tableStocks %}
    {% set view = utils.getStockView(stock, config) %}
    <tr>
      <td><span class="bold">{{ view.name }}</span></td>
      <td>
        <span>{{ view.value }}</span>
        <span class="badge {{ view.change.trend }}">
          <span>{{ view.change.value }}</span>
          <span>{{ view.change.percent }}</span>
        </span>
      </td>
      <td>
        {% if view.purchasePrice %}
          <span>{{ view.purchasePrice }}</span>
          <span class="badge {{ view.performance.trend }}">
            <span>{{ view.performance.value }}</span>
            <span>{{ view.performance.percent }}</span>
          </span>
        {% endif %}
      </td>
      <td>
        {% if view.purchasePrice %}
          <span>{{ view.performanceSum }}</span>
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% endmacro %}
